[Unit]
Description=Solera boot health check: network (NetworkManager)
Documentation=https://github.com/calambrenet/solera
# Direct probe of NetworkManager.service; deliberately NOT After=network.target
# or network-online.target (NetworkManager-wait-online is masked on purpose).
After=multi-user.target
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/solera/solera-bootcheck-network
# Short bounded window: the network probe must never keep the boot waiting.
TimeoutStartSec=20s

[Install]
# Enabled by symlink in boot-complete.target.requires/ (see PKGBUILD).
RequiredBy=boot-complete.target
