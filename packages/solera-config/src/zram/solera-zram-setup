#!/bin/bash
# Configure /dev/zram0 as swap without relying on generated .device units.

set -euo pipefail

if swapon --noheadings --raw --show=NAME | grep -q '^/dev/zram[0-9]\+$'; then
    exit 0
fi

if ! modprobe zram; then
    printf 'solera-zram: zram module unavailable, skipping\n' >&2
    exit 0
fi

dev_id=0
if [[ ! -e /sys/block/zram0 ]]; then
    if [[ -r /sys/class/zram-control/hot_add ]]; then
        dev_id=$(cat /sys/class/zram-control/hot_add) || dev_id=''
        udevadm settle
    fi
fi

if [[ -z "${dev_id:-}" ]]; then
    printf 'solera-zram: hot_add did not return a zram device id, skipping\n' >&2
    exit 0
fi

dev="/dev/zram${dev_id}"
sys="/sys/block/zram${dev_id}"

for _ in {1..20}; do
    [[ -e "$sys/disksize" && -b "$dev" ]] && break
    sleep 0.1
done

if [[ ! -e "$sys/disksize" || ! -b "$dev" ]]; then
    printf 'solera-zram: %s not ready after hot_add, skipping\n' "$dev" >&2
    exit 0
fi

if [[ -e "$sys/comp_algorithm" ]] && grep -qw zstd "$sys/comp_algorithm"; then
    printf 'zstd' > "$sys/comp_algorithm"
fi

mem_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
size_mib=$(( mem_kib / 1024 ))
if (( size_mib > 8192 )); then
    size_mib=8192
fi
if (( size_mib < 256 )); then
    size_mib=256
fi

printf '%s\n' "$(( size_mib * 1024 * 1024 ))" > "$sys/disksize"
mkswap -U clear "$dev" >/dev/null
swapon --priority 100 "$dev"
