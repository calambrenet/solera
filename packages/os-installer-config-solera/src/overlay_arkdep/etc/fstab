# /etc/fstab plantilla aplicada por os-installer al deployment de Solera.
#
# /boot (ESP) va aquí con x-systemd.automount. Razón:
#
#   - systemd-gpt-auto-generator NO sirve para montar /boot en Solera: se
#     abstiene de crear el automount cuando el directorio /boot ya contiene
#     archivos, y el rootfs del deployment trae vmlinuz/initramfs en /boot.
#     Resultado: /boot nunca se montaba y `arkdep deploy` (= `solera update`)
#     fallaba con "read-only filesystem" al escribir el kernel nuevo en el ESP.
#
#   - x-systemd.automount crea un automount LAZY independiente del generador:
#     no bloquea el arranque (no se espera al ESP en local-fs.target, así que
#     no hay emergency mode si tarda en enumerarse) y monta el ESP rw on-demand
#     cuando algo accede a /boot (arkdep al desplegar). nofail refuerza que un
#     fallo del ESP nunca tumbe el boot. systemd-boot sigue leyendo el ESP vía
#     firmware UEFI antes de que Linux exista, así que el arranque no depende
#     de este mount.
#
# Los 4 subvols Btrfs son datos persistentes que sobreviven al cambio de
# deployment (rollback no pierde nada). nofail para que un fallo de mount
# (extremadamente raro: misma partición que root) no caiga a emergency mode.
#
# UUID en lugar de device path: estable, independiente del orden de
# enumeración de discos (sda2 puede ser sdb2 si se añade otro disco).

UUID=@ROOT_UUID@  /home             btrfs  rw,relatime,subvol=arkdep/shared/home,compress=zstd,nofail    0 0
UUID=@ROOT_UUID@  /root             btrfs  rw,relatime,subvol=arkdep/shared/root,compress=zstd,nofail    0 0
UUID=@ROOT_UUID@  /arkdep           btrfs  rw,relatime,subvol=arkdep,compress=zstd,nofail                 0 0
UUID=@ROOT_UUID@  /var/lib/flatpak  btrfs  rw,relatime,subvol=arkdep/shared/flatpak,compress=zstd,nofail  0 0
UUID=@BOOT_UUID@  /boot             vfat   rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro,nofail,x-systemd.automount,x-systemd.device-timeout=30s  0 2
