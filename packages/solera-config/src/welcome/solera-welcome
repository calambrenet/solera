#!/usr/bin/python3
"""
solera-welcome — ventana de bienvenida que aparece al primer login GUI.

Shebang con ruta absoluta al intérprete del sistema (NO `/usr/bin/env
python3`): PyGObject (`gi`) sólo existe en el Python de Arch. Si el usuario
tiene Homebrew/pyenv/conda delante en el PATH, `env python3` resolvería a un
intérprete sin `gi` y la app fallaría con "No module named 'gi'".

Diseño minimalista en GTK4 + libadwaita: muestra logo, descripción breve,
los cuatro comandos clave de Solera (flatpak, distrobox, brew, arkdep),
y enlaces a documentación.

Se lanza manualmente desde el menú de aplicaciones (solera-welcome.desktop);
no hay autostart ni marker file, así que no suprime su propia reaparición.
"""

import os
import sys
import traceback
from pathlib import Path

# Salida de diagnóstico: si algo sale mal con GTK/Adw, escribe a
# /tmp/solera-welcome.log para que el usuario pueda revisar qué falló.
LOG_FILE = Path("/tmp") / f"solera-welcome.{os.environ.get('USER', 'unknown')}.log"


def log(msg: str) -> None:
    try:
        with LOG_FILE.open("a") as f:
            f.write(f"{msg}\n")
    except Exception:
        pass


# Evitar arrancar durante la sesión de gnome-initial-setup (donde no hay
# usuario real). gnome-initial-setup usa un home temporal en /run/.
if "/run/gnome-initial-setup" in os.environ.get("HOME", ""):
    log("Saltando: sesión de gnome-initial-setup detectada")
    sys.exit(0)

try:
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio, Gtk  # noqa: E402
except Exception as e:
    log(f"ERROR importando GTK/Adw: {e}")
    log(traceback.format_exc())
    sys.exit(1)

LOGO_PATH = "/usr/share/pixmaps/solera-logo.svg"
DOCS_URL = "https://github.com/calambrenet/solera"
ISSUES_URL = "https://github.com/calambrenet/solera/issues"


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application):
        super().__init__(application=app, title="Bienvenido a Solera")
        self.set_default_size(620, 720)
        self.set_resizable(False)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)

        clamp = Adw.Clamp(maximum_size=560, tightening_threshold=400)
        scrolled.set_child(clamp)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_margin_top(32)
        box.set_margin_bottom(24)
        box.set_margin_start(16)
        box.set_margin_end(16)
        clamp.set_child(box)

        # Logo
        if Path(LOGO_PATH).exists():
            logo = Gtk.Image.new_from_file(LOGO_PATH)
            logo.set_pixel_size(96)
            box.append(logo)

        # Título
        title = Gtk.Label(label="¡Bienvenido a Solera!")
        title.add_css_class("title-1")
        title.set_halign(Gtk.Align.CENTER)
        box.append(title)

        subtitle = Gtk.Label(
            label=(
                "Una distribución inmutable y atómica basada en Arch. "
                "Cada release es reproducible bit a bit; cada actualización "
                "es transaccional con rollback gratuito."
            )
        )
        subtitle.add_css_class("body")
        subtitle.set_wrap(True)
        subtitle.set_justify(Gtk.Justification.CENTER)
        subtitle.set_halign(Gtk.Align.CENTER)
        box.append(subtitle)

        # Comandos clave
        commands_group = Adw.PreferencesGroup(title="Comandos clave")
        for icon, title_text, command, desc in [
            ("application-x-executable-symbolic", "Apps GUI",
             "flatpak install flathub <app-id>",
             "Instala aplicaciones gráficas desde Flathub."),
            ("utilities-terminal-symbolic", "Desarrollo",
             "distrobox-create / distrobox-enter",
             "Contenedores con tu distro de toolchain favorita."),
            ("system-software-install-symbolic", "CLI personal",
             "brew install <utilidad>",
             "Herramientas de línea de comandos vía Homebrew. "
             "Primera vez: instala Homebrew con "
             "NONINTERACTIVE=1 /bin/bash -c \"$(curl -fsSL "
             "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" "
             "y abre una terminal nueva."),
            ("system-software-update-symbolic", "Actualizar sistema",
             "arkdep update  (luego reinicia)",
             "Actualización atómica con rollback disponible."),
        ]:
            row = Adw.ActionRow(title=title_text, subtitle=command)
            row.set_icon_name(icon)
            row.add_css_class("property")
            label_desc = Gtk.Label(label=desc)
            label_desc.add_css_class("dim-label")
            label_desc.add_css_class("caption")
            label_desc.set_wrap(True)
            label_desc.set_xalign(0)
            row.add_suffix(label_desc)
            commands_group.add(row)
        box.append(commands_group)

        # Recursos
        resources_group = Adw.PreferencesGroup(title="Recursos")

        docs_row = Adw.ActionRow(title="Documentación y código")
        docs_row.set_subtitle(DOCS_URL)
        docs_row.set_icon_name("text-x-generic-symbolic")
        docs_row.set_activatable(True)
        docs_row.connect("activated", lambda _r: self._open_url(DOCS_URL))
        resources_group.add(docs_row)

        issues_row = Adw.ActionRow(title="Reportar problema")
        issues_row.set_subtitle(ISSUES_URL)
        issues_row.set_icon_name("dialog-warning-symbolic")
        issues_row.set_activatable(True)
        issues_row.connect("activated", lambda _r: self._open_url(ISSUES_URL))
        resources_group.add(issues_row)

        box.append(resources_group)

        # Footer: solo botón cerrar (la welcome se lanza manualmente desde
        # el menú de apps, no por autostart, así que no tiene sentido un
        # "no mostrar al iniciar" — no hay nada que suprimir).
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.set_margin_top(8)
        footer.set_margin_bottom(16)
        footer.set_margin_start(16)
        footer.set_margin_end(16)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        footer.append(spacer)

        close_btn = Gtk.Button(label="Cerrar")
        close_btn.add_css_class("suggested-action")
        close_btn.connect("clicked", lambda _b: self.close())
        footer.append(close_btn)

        toolbar.set_content(scrolled)
        toolbar.add_bottom_bar(footer)
        self.set_content(toolbar)

    def _open_url(self, url: str) -> None:
        launcher = Gtk.UriLauncher.new(url)
        launcher.launch(self, None, None, None)


class WelcomeApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.solera.Welcome",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )

    def do_activate(self):
        win = WelcomeWindow(self)
        win.present()


def main() -> int:
    log("Lanzando WelcomeApp")
    app = WelcomeApp()
    try:
        return app.run(sys.argv)
    except Exception as e:
        log(f"ERROR en app.run: {e}")
        log(traceback.format_exc())
        return 1


if __name__ == "__main__":
    sys.exit(main())
