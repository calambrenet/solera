# Paquetes del entorno live de Solera. Su único trabajo es: arrancar GNOME,
# ejecutar os-installer, llamar a arkdep para desplegar Solera. NO es Solera
# entera.

# Base + arranque
base
linux
linux-firmware
amd-ucode
intel-ucode
btrfs-progs
dosfstools
efibootmgr
mkinitcpio
mkinitcpio-archiso
syslinux

